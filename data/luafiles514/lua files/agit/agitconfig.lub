main = function()
	local ret = true
	local msg = "success"
	for k, v in pairs(tbl_AgitInfo) do
		ret, msg = GlueFunc_SetAgitBaseInfo(k, v.Number, v.Name)
		if ret == false then
			return ret, msg
		end
	end
	for k, v in pairs(tbl_AgitInfo) do
		ret, msg = GlueFunc_SetAgitAdditionalInfo(k, v.Warp.TargetPosX, v.Warp.TargetPosY, v.Warp.CostZeny, v.Warp.CostZenySeigeTime, v.Warp.AdditionalEFST[1], v.Warp.AdditionalEFST[2])
		if ret == false then
			return ret, msg
		end
	end
	return true, "success"
end
